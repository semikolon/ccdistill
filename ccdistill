#!/usr/bin/env python3
"""
ccdistill — distill a Claude Code or Codex session transcript into a lean resume brief.

Purpose:
  Resuming a large, cold (>cache-TTL) CC session with `claude --resume` reprocesses
  the ENTIRE transcript as fresh input on the first turn — one of the most expensive
  requests you can send, spent mostly re-reading tool-output noise you'll ignore.
  Instead: distill the transcript from disk to signal (human + assistant text,
  reasoning, and which tools were called + why), drop the bulky tool OUTPUTS /
  injected CLAUDE.md / system-reminders, and hand THAT to a FRESH session which
  reconstructs state cheaply and verifies against the live repo before acting.

Deterministic — no LLM call. The fresh session does the reconstruction as its first
turn (which is a turn you were going to send anyway), so it's effectively free.

Usage:
  ccdistill                     # newest session in the current dir's project
  ccdistill <session-id>        # a specific session (searched across all roots)
  ccdistill <path/to.jsonl>     # a specific transcript file
  ccdistill "<title words>"     # a session by its (Claude Desktop) title, substring match
  ccdistill --list [--json]     # discover recent sessions (non-interactive; for agents)
  ccdistill --pick              # interactive numbered picker (human terminal only)
  ccdistill --project <name>    # newest session in a named project

  ccdistill | pbcopy            # then paste into a fresh `claude` and hit enter
  ccdistill -o /tmp/handoff.md  # then in fresh claude: "read /tmp/handoff.md and continue"

Agents / scripts (non-interactive): `ccdistill --list --json` → choose an id
(size_kb hints how substantial a session is — skip a tiny just-started one, e.g.
your own) → `ccdistill <id>`. `--pick` is for a human terminal and errors under
a non-tty rather than hanging.

Flags:
  -o FILE            write to FILE instead of stdout
  --list             list recent sessions, machine-readable (id/time/size/project/title)
  --json             with --list: JSON instead of TSV
  --limit N          with --list: max rows (default 20)
  --pick             interactive picker (human terminal only; errors under a non-tty)
  --project NAME     select within a named project instead of cwd
  --all-projects     with --list/--pick, span every project
  --no-thinking      drop assistant reasoning (thinking) blocks
  --thinking-chars N truncate each thinking block to N chars (default 700)
  --no-header        omit the repo-verify resume-prompt header
  --raw              transcript only, no header + no metadata (for further piping)

Env:
  CCDISTILL_USER_LABEL     label for the human's turns (default: User)
  CCDISTILL_ARCHIVE_ROOTS  extra transcript roots (os.pathsep-separated) beyond
                           ~/.claude/projects — e.g. an archive volume

Codex sessions (OpenAI Codex CLI / desktop):
  The same program reads Codex transcripts (~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl).
  Installed under a second name, `codexdistill` (a symlink), it defaults to Codex:
  `codexdistill` = newest Codex session for this dir, `codexdistill --list` lists them.
  Under either name a path or session id is read in whatever format it is.
  Codex runs shell through a JS `exec` tool, so tool intents show as
  `⏺ exec: <shell command>`; file edits happen inside those commands. Codex keeps
  its reasoning encrypted, so only its short reasoning summaries survive.

Notes:
  - Handles the compaction chain (multiple files sharing one sessionId).
  - A project can live in SEVERAL dirs at once (live root + archive roots): all
    matching dirs are unioned, deduped by session id (newest copy wins) — an
    archive root must never shadow live sessions.
  - Session titles from the Claude Desktop app (claude-code-sessions metadata)
    are joined into --list/--pick and matchable as a positional arg.
  - Dodges the stale-transcript-path bug by resolving via sessionId + newest mtime.
  - Skips subagent/sidechain turns, compaction summaries, and all metadata line types
    (attachment/system/file-history-snapshot/permission-mode/...), which is where
    modern CC injects CLAUDE.md + <system-reminder>.
  - Schema is internal to CC and drifts across versions; parser is defensive
    (only touches user/assistant + known block types) and warns on an unseen version.
"""

from __future__ import annotations   # `X | Y` annotations on Python 3.8/3.9 (e.g. Big Sur)
import sys, os, re, json, glob, argparse
from pathlib import Path

HOME = Path.home()
LIVE_ROOT = HOME / ".claude" / "projects"
# Extra transcript roots (e.g. an archive volume) — os.pathsep-separated, searched
# after the live root. Set CCDISTILL_ARCHIVE_ROOTS to include archived sessions.
_EXTRA_ROOTS = [p for p in os.environ.get("CCDISTILL_ARCHIVE_ROOTS", "").split(os.pathsep) if p.strip()]
USER_LABEL = os.environ.get("CCDISTILL_USER_LABEL", "User")   # label for the human's turns
KNOWN_VERSION_PREFIX = "2."          # warn (don't fail) outside this major line
PROG = Path(sys.argv[0]).name or "ccdistill"
CODEX_DEFAULT = PROG.startswith("codex")   # installed as `codexdistill` → Codex is the default store
CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
CODEX_ROOTS = [CODEX_HOME / "sessions", CODEX_HOME / "archived_sessions"]

# text blocks defensively skipped if an older-version session inlines boilerplate
_NOISE = ("<system-reminder>", "Codebase and user instructions are shown below",
          "This session is being continued", "<command-name>",
          "<local-command-stdout>", "DO NOT respond to these")

_SECRET_RE = re.compile(
    r"(sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}"
    r"|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|(api[_-]?key|secret|token|password|bearer)\s*[:=]\s*['\"]?[A-Za-z0-9/_+\-]{16,})",
    re.IGNORECASE)


def _roots():
    # Live root (~/.claude/projects) is always searched — that's where every live
    # session lives. Extra archive roots (CCDISTILL_ARCHIVE_ROOTS) are additive.
    r = [LIVE_ROOT] + [Path(p) for p in _EXTRA_ROOTS]
    return [p for p in r if Path(p).exists()]


def _encode_cwd(path: str) -> str:
    """CC encodes an absolute cwd by replacing / and . with - (leading / → leading -)."""
    return re.sub(r"[/.]", "-", os.path.abspath(path))


def _project_dirs(name=None):
    """Resolve ALL CC project dirs for a named project or the current cwd, across
    every root (live first). A project routinely exists in several dirs at once —
    the live root plus archive roots — and picking just one silently hides the
    rest (the bug this replaced: an archive root's exact match shadowed the live
    dir, so --list showed only archived sessions).
    For cwd: exact-encode matches from every root; if none anywhere, the longest
    project-name that is a prefix of the encoded cwd, per root (so running inside
    a subdirectory still maps to its project)."""
    roots = _roots()
    if name:
        # match project dirs whose decoded tail equals `name`, in root order
        out = []
        for root in roots:
            for d in sorted(Path(root).iterdir()):
                if d.is_dir() and d.name.rstrip("-").rsplit("-", 1)[-1] == name:
                    out.append(d)
        return out
    enc = _encode_cwd(os.getcwd())
    exact, best = [], []
    for root in roots:
        root_best = None
        for d in Path(root).iterdir():
            if not d.is_dir():
                continue
            if d.name == enc:
                exact.append(d)
            elif enc.startswith(d.name) and (root_best is None or len(d.name) > len(root_best.name)):
                root_best = d
        if root_best is not None:
            best.append(root_best)
    return exact or best


def _newest_mtime(project_dir: Path) -> float:
    files = list(project_dir.glob("*.jsonl"))
    return max((f.stat().st_mtime for f in files), default=0.0)


def _session_id_of(jsonl: str, max_lines=50):
    try:
        with open(jsonl, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= max_lines:
                    break
                try:
                    sid = json.loads(line).get("sessionId")
                except Exception:
                    continue
                if sid:
                    return sid
    except Exception:
        return None
    return None


def _chain_for_session(sid: str, project_dirs):
    """All transcript files for a sessionId (compaction chain) across the given
    project dirs, oldest-first. Deduped by file stem — if the same transcript
    exists in both a live and an archive dir, the newest copy wins."""
    if isinstance(project_dirs, Path):
        project_dirs = [project_dirs]
    seen = {}  # stem -> (path, mtime)
    for pd in project_dirs:
        for f in pd.glob("*.jsonl"):
            if "subagent" in f.name or f.name.startswith("agent-"):
                continue
            if _session_id_of(str(f)) == sid:
                mt = f.stat().st_mtime
                if f.stem not in seen or mt > seen[f.stem][1]:
                    seen[f.stem] = (str(f), mt)
    out = sorted(seen.values(), key=lambda x: x[1])
    return [p for p, _ in out]


_CCD_SESSIONS_ROOT = HOME / "Library" / "Application Support" / "Claude" / "claude-code-sessions"
_ccd_titles_cache = None


def _ccd_titles():
    """cliSessionId (= JSONL stem) -> user-visible session title, from the Claude
    Desktop app's per-session metadata JSONs. Empty dict when the app isn't
    installed or the layout drifts — everything degrades to first-user-message."""
    global _ccd_titles_cache
    if _ccd_titles_cache is not None:
        return _ccd_titles_cache
    titles = {}
    try:
        for f in _CCD_SESSIONS_ROOT.glob("*/*/*.json"):
            try:
                with open(f, encoding="utf-8") as fh:
                    o = json.load(fh)
                sid, title = o.get("cliSessionId"), o.get("title")
                if sid and title:
                    titles[sid] = " ".join(str(title).split())
            except Exception:
                continue
    except Exception:
        pass
    _ccd_titles_cache = titles
    return titles


def _dirs_containing_session(sid: str):
    """All project dirs (across all roots) holding transcript files for sid."""
    dirs = []
    for root in _roots():
        for d in Path(root).iterdir():
            if not d.is_dir():
                continue
            if any(_session_id_of(str(f)) == sid or f.stem == sid
                   for f in d.glob(f"{sid[:8]}*.jsonl")):
                dirs.append(d)
    return dirs


def _find_session(arg: str):
    """arg is a .jsonl path, a session-id (full UUID or unique short prefix), or a
    (Claude Desktop) session-title substring. Return (chain, project_dir)."""
    p = Path(arg)
    if p.suffix == ".jsonl" and p.exists():
        sid = _session_id_of(str(p)) or p.stem
        return _chain_for_session(sid, p.parent), p.parent
    # 1) exact match on filename stem or in-file sessionId
    for root in _roots():
        for d in Path(root).iterdir():
            if not d.is_dir():
                continue
            for f in d.glob("*.jsonl"):
                if f.stem == arg or _session_id_of(str(f)) == arg:
                    sid = _session_id_of(str(f)) or f.stem
                    dirs = _dirs_containing_session(sid) or [d]
                    return _chain_for_session(sid, dirs), dirs[0]
    # 2) unique-prefix match (git-style short ids; CC names files by session UUID)
    matches = {}  # sid -> (project_dir, mtime)
    for root in _roots():
        rp = Path(root)
        if not rp.is_dir():
            continue
        for d in rp.iterdir():
            if not d.is_dir():
                continue
            for f in d.glob(f"{arg}*.jsonl"):
                if "subagent" in f.name or f.name.startswith("agent-"):
                    continue
                sid = _session_id_of(str(f)) or f.stem
                mt = f.stat().st_mtime
                if sid not in matches or mt > matches[sid][1]:
                    matches[sid] = (d, mt)
    # 3) title-substring match against the Claude Desktop session titles
    #    (the name a human actually knows a session by)
    if not matches and not re.fullmatch(r"[0-9a-fA-F-]+", arg):
        needle = arg.lower()
        for sid, title in _ccd_titles().items():
            if needle in title.lower():
                dirs = _dirs_containing_session(sid)
                if dirs:
                    matches[sid] = (dirs[0], max(
                        f.stat().st_mtime for d in dirs for f in d.glob(f"{sid[:8]}*.jsonl")))
    if len(matches) == 1:
        sid, (d, _mt) = next(iter(matches.items()))
        dirs = _dirs_containing_session(sid) or [d]
        return _chain_for_session(sid, dirs), dirs[0]
    if len(matches) > 1:
        titles = _ccd_titles()
        lines = [f"ccdistill: '{arg}' is ambiguous — {len(matches)} sessions match:"]
        for sid, (d, _mt) in sorted(matches.items(), key=lambda kv: kv[1][1], reverse=True)[:8]:
            t = titles.get(sid, "")
            lines.append(f"  {sid}  ({d.name}){'  ' + t if t else ''}")
        print("\n".join(lines), file=sys.stderr)
        raise SystemExit(2)
    return [], None


def _recent_sessions(project_dir: Path, limit=15):
    rows = []
    for f in project_dir.glob("*.jsonl"):
        if "subagent" in f.name or f.name.startswith("agent-"):
            continue
        rows.append((f, f.stat().st_mtime))
    rows.sort(key=lambda x: x[1], reverse=True)
    return rows[:limit]


def _first_user_title(jsonl: str) -> str:
    try:
        for line in open(jsonl, encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") != "user":
                continue
            c = (o.get("message") or {}).get("content")
            t = c if isinstance(c, str) else " ".join(
                b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text"
            ) if isinstance(c, list) else ""
            t = " ".join(t.split())
            if t and not any(m in t for m in _NOISE):
                return t[:70]
    except Exception:
        pass
    return "(no title)"


def _dedupe_rows(rows):
    """Dedupe (path, mtime, dir) rows by file stem, newest copy wins — the same
    transcript can exist in both a live and an archive dir."""
    seen = {}
    for f, m, d in rows:
        stem = Path(f).stem
        if stem not in seen or m > seen[stem][1]:
            seen[stem] = (f, m, d)
    out = list(seen.values())
    out.sort(key=lambda x: x[1], reverse=True)
    return out


def _scope_rows(project=None, all_projects=False, limit=20):
    """Recent sessions for a scope, newest-first: list of (path, mtime, project_dir).
    Unions every matching project dir across all roots (live + archives)."""
    if all_projects:
        rows = []
        for root in _roots():
            for d in Path(root).iterdir():
                if d.is_dir():
                    rows += [(f, m, d) for f, m in _recent_sessions(d, 40)]
        return _dedupe_rows(rows)[:limit], None
    dirs = _project_dirs(project)
    if not dirs:
        return [], None
    rows = []
    for pd in dirs:
        rows += [(f, m, pd) for f, m in _recent_sessions(pd, limit)]
    return _dedupe_rows(rows)[:limit], dirs[0]


def _emit_list(rows, as_json):
    """Non-interactive session discovery for agents/scripts. Each row's `id` is what
    you pass back to `ccdistill <id>`. TSV by default (id, modified, size, project,
    title); JSON with --json. `size_kb` is a free proxy for how substantial a session
    is — an agent can skip a tiny just-started session (e.g. its own)."""
    import datetime as _dt
    titles = _ccd_titles()
    items = []
    for f, m, d in rows:
        if isinstance(d, str):        # a Codex row carries its project name, not a dir
            sid = _codex_id(f)
            project, title = d, _codex_titles().get(sid) or _codex_first_request(f)
        else:
            sid = Path(f).stem
            project, title = d.name.rsplit("-", 1)[-1], titles.get(sid) or _first_user_title(str(f))
        items.append({
            "id": sid,
            "modified": _dt.datetime.fromtimestamp(m).isoformat(timespec="minutes"),
            "project": project,
            "size_kb": Path(f).stat().st_size // 1024,
            "title": title,
        })
    if as_json:
        print(json.dumps(items, indent=2))
    else:
        for it in items:
            print(f'{it["id"]}\t{it["modified"]}\t{it["size_kb"]:>6} KB\t'
                  f'{it["project"]:<16}\t{it["title"]}')


# ---- tool_use → one-line intent stub -----------------------------------------
_TOOL_KEY = {
    "Bash": "command", "Edit": "file_path", "MultiEdit": "file_path",
    "Write": "file_path", "Read": "file_path", "NotebookEdit": "notebook_path",
    "Grep": "pattern", "Glob": "pattern", "Task": "description",
    "WebSearch": "query", "WebFetch": "url", "Skill": "command",
    "TodoWrite": None,  # noise
}


def _tool_stub(name: str, inp: dict) -> str | None:
    if not isinstance(inp, dict):
        return f"⏺ {name}"
    key = _TOOL_KEY.get(name, "__auto__")
    if key is None:
        return None
    if key == "__auto__":
        for k in ("command", "file_path", "path", "pattern", "query", "url",
                  "description", "prompt", "cypher", "content"):
            if k in inp:
                key = k
                break
        else:
            key = next(iter(inp), None)
    val = inp.get(key, "") if key else ""
    val = " ".join(str(val).split())
    if len(val) > 110:
        val = val[:110] + "…"
    return f"⏺ {name}: {val}" if val else f"⏺ {name}"


# ---- distillation ------------------------------------------------------------
def distill(chain, keep_thinking=True, thinking_chars=700, level="full"):
    """level='full' keeps everything; level='user' keeps the human's turns plus the
    assistant's tool-call intents only (drops assistant prose + thinking) — the
    cheap arc-only view for very long sessions."""
    turns = []
    for jsonl in chain:
        try:
            fh = open(jsonl, encoding="utf-8", errors="replace")
        except Exception:
            continue
        with fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("type") not in ("user", "assistant"):
                    continue          # drops attachment/system/snapshot/... = CLAUDE.md+reminders
                if o.get("isSidechain") or o.get("isCompactSummary"):
                    continue
                msg = o.get("message") or {}
                cont = msg.get("content")
                role = USER_LABEL if o.get("type") == "user" else "Claude"
                pieces = []
                if isinstance(cont, str):
                    t = cont.strip()
                    if t and not any(m in t for m in _NOISE):
                        pieces.append(t)
                elif isinstance(cont, list):
                    for b in cont:
                        if not isinstance(b, dict):
                            continue
                        bt = b.get("type")
                        lean = level == "user" and role != USER_LABEL
                        if bt == "text":
                            if lean:
                                continue
                            t = (b.get("text") or "").strip()
                            if t and not any(m in t for m in _NOISE):
                                pieces.append(t)
                        elif bt == "thinking" and keep_thinking and not lean:
                            th = " ".join((b.get("thinking") or "").split())
                            if th:
                                if len(th) > thinking_chars:
                                    th = th[:thinking_chars] + " […]"
                                pieces.append(f"> 💭 {th}")
                        elif bt == "tool_use":
                            stub = _tool_stub(b.get("name", "?"), b.get("input"))
                            if stub:
                                pieces.append(stub)
                        # tool_result → dropped (bulky output; the tool_use stub carries intent)
                if pieces:
                    turns.append((role, "\n".join(pieces), (o.get("timestamp") or "")[:19]))
    return turns


# ---- Codex ------------------------------------------------------------------
# A Codex rollout file is one session: line 1 is `session_meta` (id, cwd, git),
# then `response_item` records (message / reasoning / custom_tool_call / ...),
# `event_msg`, `turn_context`, `compacted`. Only response_item carries the
# conversation; everything else is bookkeeping and is skipped.

# User-role text blocks that are injected context, not something the human typed.
_CODEX_INJECTED = ("# AGENTS.md instructions", "<environment_context>", "<INSTRUCTIONS>",
                   "<external_codex_apps_open_page>", "<image", "</image>",
                   "<user_instructions>", "<turn_aborted>")
_CODEX_CMD_RE = re.compile(r'"?cmd"?\s*:\s*("(?:[^"\\]|\\.)*")')
_CODEX_TOOL_RE = re.compile(r"tools\.([A-Za-z_][\w]*)\(")


def _codex_files():
    out = []
    for root in CODEX_ROOTS:
        if root.is_dir():
            out += [p for p in root.rglob("rollout-*.jsonl")]
    return out


def _is_codex(path) -> bool:
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return json.loads(fh.readline()).get("type") == "session_meta"
    except Exception:
        return False


def _codex_meta(path) -> dict:
    """session_meta payload (id, cwd, timestamp, git, cli_version); {} if unreadable."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            o = json.loads(fh.readline())
        return (o.get("payload") or {}) if o.get("type") == "session_meta" else {}
    except Exception:
        return {}


def _codex_id(path) -> str:
    stem = Path(path).stem
    return _codex_meta(path).get("id") or stem[-36:]


_codex_titles_cache = None


def _codex_titles():
    """id -> thread name from ~/.codex/session_index.jsonl (last entry wins)."""
    global _codex_titles_cache
    if _codex_titles_cache is None:
        titles = {}
        try:
            for line in open(CODEX_HOME / "session_index.jsonl", encoding="utf-8", errors="replace"):
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("id") and o.get("thread_name"):
                    titles[o["id"]] = " ".join(str(o["thread_name"]).split())
        except Exception:
            pass
        _codex_titles_cache = titles
    return _codex_titles_cache


def _codex_in_scope(session_cwd: str, here: str) -> bool:
    """A Codex session belongs to this dir when either is inside the other."""
    if not session_cwd:
        return False
    return here == session_cwd or here.startswith(session_cwd + "/") or session_cwd.startswith(here + "/")


def _codex_scope_rows(project=None, all_projects=False, limit=20):
    """Recent Codex sessions, newest-first: list of (path, mtime, project_name)."""
    here = os.path.abspath(os.getcwd())
    rows = []
    for f in _codex_files():
        cwd = _codex_meta(f).get("cwd", "")
        if all_projects or (project and Path(cwd).name == project) or (not project and _codex_in_scope(cwd, here)):
            rows.append((f, f.stat().st_mtime, Path(cwd).name or "?"))
    rows.sort(key=lambda r: r[1], reverse=True)
    return rows[:limit]


def _codex_find(arg: str):
    """A Codex rollout path for a path, session id (or unique prefix), or thread-name
    substring; None when nothing matches."""
    p = Path(arg)
    if p.suffix == ".jsonl" and p.exists():
        return p if _is_codex(p) else None
    files = _codex_files()
    hits = [f for f in files if f.stem[-36:] == arg]
    if not hits:
        hits = [f for f in files if f.stem[-36:].startswith(arg)] if re.fullmatch(r"[0-9a-fA-F-]{4,}", arg) else []
    if not hits and not re.fullmatch(r"[0-9a-fA-F-]+", arg):
        ids = {sid for sid, t in _codex_titles().items() if arg.lower() in t.lower()}
        hits = [f for f in files if f.stem[-36:] in ids]
    if len(hits) > 1:
        titles = _codex_titles()
        lines = [f"{PROG}: '{arg}' is ambiguous — {len(hits)} Codex sessions match:"]
        for f in sorted(hits, key=lambda f: f.stat().st_mtime, reverse=True)[:8]:
            lines.append(f"  {f.stem[-36:]}  {titles.get(f.stem[-36:], '')}")
        print("\n".join(lines), file=sys.stderr)
        raise SystemExit(2)
    return hits[0] if hits else None


def _codex_subagent(meta: dict) -> str:
    """'subagent <nickname> (<task path>) of <parent id>' for a Codex subagent, else ''.
    A subagent's task arrives through its parent's spawn call, so its own file has no
    user turn; the parent's transcript holds the request."""
    if meta.get("thread_source") != "subagent":
        return ""
    name = meta.get("agent_nickname") or "?"
    task = (meta.get("agent_path") or "").rsplit("/", 1)[-1]
    parent = meta.get("parent_thread_id") or meta.get("session_id") or "?"
    return f"subagent {name}" + (f" ({task})" if task else "") + f" of {parent}"


def _codex_first_request(path) -> str:
    sub = _codex_subagent(_codex_meta(path))
    if sub:
        return "[" + sub + "]"
    try:
        for line in open(path, encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
            except Exception:
                continue
            p = o.get("payload") or {}
            if o.get("type") == "response_item" and p.get("type") == "message" and p.get("role") == "user":
                t = " ".join(_codex_user_text(p.get("content")).split())
                if t:
                    return t[:70]
    except Exception:
        pass
    return "(no title)"


def _codex_user_text(content) -> str:
    """What the human typed: injected AGENTS.md / environment / image blocks dropped;
    the desktop app's attachment wrapper reduced to the request plus the file names
    and any annotated passages it quotes."""
    out = []
    for b in content or []:
        if not isinstance(b, dict) or b.get("type") != "input_text":
            continue
        t = b.get("text") or ""
        s = t.strip()
        if not s or s.startswith(_CODEX_INJECTED):
            continue
        if "## My request:" in t:
            head, req = t.split("## My request:", 1)
            pre = []
            names = re.findall(r"^## (.+?): /", head, re.M)
            if names:
                pre.append("[attached: " + ", ".join(names) + "]")
            ann = re.search(r"<response-annotations>\s*(.*?)\s*</response-annotations>", head, re.S)
            if ann:
                try:
                    for item in json.loads(ann.group(1)):
                        quote = " ".join(str(item.get("text", "")).split())[:200]
                        note = item.get("comment") or ""
                        pre.append(f"[on «{quote}»" + (f": {note}" if note else "") + "]")
                except Exception:
                    pass
            s = "\n".join(pre + [req.strip()])
        out.append(s)
    return "\n".join(out).strip()


def _codex_commands(script: str):
    """Shell commands inside a Codex `exec` script, in order."""
    cmds = []
    for m in _CODEX_CMD_RE.finditer(script or ""):
        try:
            cmds.append(json.loads(m.group(1)))
        except Exception:
            continue
    return cmds


def _codex_tool_stubs(script: str):
    stubs = []
    for c in _codex_commands(script):
        val = " ".join(str(c).split())
        stubs.append("⏺ exec: " + (val[:110] + "…" if len(val) > 110 else val))
    others = [n for n in _CODEX_TOOL_RE.findall(script or "") if n not in ("exec_command", "write_stdin")]
    stubs += [f"⏺ {n}" for n in dict.fromkeys(others)]
    if not stubs and (script or "").strip():
        val = " ".join(script.split())
        stubs.append("⏺ exec (script): " + (val[:110] + "…" if len(val) > 110 else val))
    return stubs


def distill_codex(path, keep_thinking=True, thinking_chars=700, level="full"):
    """Codex rollout → the same (role, text, ts) turn list `distill` returns."""
    turns = []
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except Exception:
        return turns
    lean = level == "user"
    with fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") != "response_item":
                continue          # session_meta/event_msg/turn_context/compacted/world_state
            p = o.get("payload") or {}
            pt = p.get("type")
            ts = (o.get("timestamp") or "")[:19]
            if pt == "message":
                role = p.get("role")
                if role == "user":
                    t = _codex_user_text(p.get("content"))
                    if t:
                        turns.append((USER_LABEL, t, ts))
                elif role == "assistant" and not lean:
                    t = "\n".join((b.get("text") or "").strip() for b in p.get("content") or []
                                  if isinstance(b, dict) and b.get("type") == "output_text").strip()
                    if t:
                        turns.append(("Codex", t, ts))
                # developer/system messages = injected instructions → dropped
            elif pt == "reasoning" and keep_thinking and not lean:
                th = " ".join(" ".join((s.get("text") or "") for s in p.get("summary") or []
                                       if isinstance(s, dict)).split())
                if th:
                    if len(th) > thinking_chars:
                        th = th[:thinking_chars] + " […]"
                    turns.append(("Codex", f"> 💭 {th}", ts))
            elif pt == "custom_tool_call":
                stubs = _codex_tool_stubs(p.get("input"))
                if p.get("name") not in (None, "exec"):
                    stubs = [f"⏺ {p['name']}"]
                if stubs:
                    turns.append(("Codex", "\n".join(stubs), ts))
            elif pt == "function_call":
                args = " ".join(str(p.get("arguments", "")).split())
                turns.append(("Codex", f"⏺ {p.get('name', '?')}: " + (args[:110] + "…" if len(args) > 110 else args), ts))
            # *_output → dropped (bulky; the call stub carries intent)
    # merge consecutive same-role pieces into one turn, as CC transcripts arrive
    merged = []
    for role, text, ts in turns:
        if merged and merged[-1][0] == role and role != USER_LABEL:
            merged[-1] = (role, merged[-1][1] + "\n" + text, merged[-1][2])
        else:
            merged.append((role, text, ts))
    return merged


def _codex_render_meta(path, kept):
    m = _codex_meta(path)
    first_ts = last_ts = ""
    try:
        for line in open(path, encoding="utf-8", errors="replace"):
            try:
                ts = (json.loads(line).get("timestamp") or "")[:16]
            except Exception:
                continue
            if ts:
                first_ts = first_ts or ts
                last_ts = ts
    except Exception:
        pass
    git = m.get("git") if isinstance(m.get("git"), dict) else {}
    return {"project": Path(m.get("cwd", "")).name or "?", "sid": m.get("id") or Path(path).stem[-36:],
            "files": 1, "kept": kept, "first_ts": first_ts, "last_ts": last_ts,
            "branch": git.get("branch", ""),
            "source": "Codex" + (f" {_codex_subagent(m)}" if _codex_subagent(m) else "")}


def _parse_bound(s, end_of_day=False):
    """Parse YYYY-MM-DD or an ISO datetime as LOCAL time and return a UTC string
    comparable to the JSONL timestamps (which are UTC). Mixing zones here would
    silently shift every boundary by the local offset."""
    import datetime as _dt
    s = (s or "").strip()
    try:
        d = _dt.datetime.fromisoformat(s)
    except ValueError:
        raise SystemExit(f"ccdistill: cannot parse {s!r} — use YYYY-MM-DD or ISO 8601")
    if len(s) == 10 and end_of_day:
        d = d.replace(hour=23, minute=59, second=59)
    if d.tzinfo is None:
        d = d.astimezone()                      # naive input = the user's local clock
    return d.astimezone(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")


def window(turns, since=None, until=None, last=None):
    """Slice a distilled session: --since/--until by wall-clock, --last by turn count."""
    lo = _parse_bound(since) if since else None
    hi = _parse_bound(until, end_of_day=True) if until else None
    if lo or hi:
        turns = [t for t in turns
                 if (not t[2]) or ((not lo or t[2] >= lo) and (not hi or t[2] <= hi))]
    if last and last > 0:
        turns = turns[-last:]
    return turns


def _est_tokens(s: str) -> int:
    return max(1, len(s) // 4)


HEADER = """\
<!-- Distilled by ccdistill — tool OUTPUTS were stripped and may be STALE. -->
You are resuming interrupted work in a NEW session. Below is a distilled brief of the
prior session: human + assistant messages, the assistant's reasoning, and which tools
were called and why. Tool OUTPUTS, injected CLAUDE.md / AGENTS.md, and system-reminders
were removed.

BEFORE taking any action, establish ground truth from the repo — do NOT trust the
brief's implied state:
  1. `git status --short`      (uncommitted work-in-progress)
  2. `git log --oneline -15`   (what actually landed)
  3. `git diff --stat HEAD`    (changed but uncommitted)
  4. run the test/build command (current red/green state)
  5. read any TODO / HANDOFF / plan files on disk

Then reconcile: which brief claims are CONFIRMED by repo state, which are CONTRADICTED
(the repo WINS), which are UNVERIFIABLE. State that reconciliation, then continue from
the prior next-step — do NOT restart completed work. Ask only if something load-bearing
is genuinely missing.

---
"""


def _cc_render_meta(chain, project_dir, kept):
    proj = project_dir.name.rsplit("-", 1)[-1] if project_dir else "?"
    sid = Path(chain[0]).stem if chain else "?"
    # date range + git branch from the transcript
    first_ts = last_ts = branch = ""
    try:
        for line in open(chain[0], encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
            except Exception:
                continue
            ts = (o.get("timestamp") or "")[:16]
            if ts and not first_ts:
                first_ts = ts
            if ts:
                last_ts = ts
            branch = branch or o.get("gitBranch") or ""
    except Exception:
        pass
    return {"project": proj, "sid": sid, "files": len(chain), "kept": kept,
            "first_ts": first_ts, "last_ts": last_ts, "branch": branch, "source": "Claude Code"}


def render(turns, meta, with_header=True, with_meta=True, slice_note=""):
    body = "\n\n".join(f"### {role}\n{text}" for role, text, *_ in turns)
    out = []
    if with_header:
        out.append(HEADER)
    if with_meta:
        out.append(
            f"**Source:** {meta['source']}  •  **Project:** {meta['project']}  •  "
            f"**Session:** {meta['sid']}  •  **Files in chain:** "
            f"{meta['files']}  •  **Turns kept:** {meta['kept']}\n"
            f"**Span:** {meta['first_ts']} → {meta['last_ts']}  •  **Branch:** {meta['branch'] or '?'}\n"
            + (f"\n> ⚠ **PARTIAL VIEW — {slice_note}.** This is a slice of the session, "
               f"not the whole thing; anything outside it is unread.\n" if slice_note else "")
        )
    out.append(body)
    return "\n".join(out).strip() + "\n"


def main():
    ap = argparse.ArgumentParser(add_help=True, description="Distill a CC session into a resume brief.")
    ap.add_argument("session", nargs="?", help="session-id or path/to.jsonl (default: newest in cwd's project)")
    ap.add_argument("-o", dest="out", help="write to FILE instead of stdout")
    ap.add_argument("--pick", action="store_true", help="numbered picker of recent sessions")
    ap.add_argument("--project", help="select within a named project instead of cwd")
    ap.add_argument("--all-projects", action="store_true", help="with --pick, list across all projects")
    ap.add_argument("--no-thinking", action="store_true")
    ap.add_argument("--thinking-chars", type=int, default=700)
    ap.add_argument("--no-header", action="store_true")
    ap.add_argument("--raw", action="store_true", help="transcript only (no header, no metadata)")
    ap.add_argument("--list", action="store_true",
                    help="list recent sessions (non-interactive — for agents/scripts); id → `ccdistill <id>`")
    ap.add_argument("--json", action="store_true", help="with --list: emit JSON instead of TSV")
    ap.add_argument("--limit", type=int, default=20, help="with --list: max rows (default 20)")
    ap.add_argument("--since", metavar="WHEN",
                    help="keep turns at/after WHEN (YYYY-MM-DD or ISO 8601, YOUR local time)")
    ap.add_argument("--until", metavar="WHEN",
                    help="keep turns at/before WHEN (bare date = end of that day, local time)")
    ap.add_argument("--last", type=int, metavar="N",
                    help="keep only the last N turns (applied after --since/--until)")
    ap.add_argument("--level", choices=("full", "user"), default="full",
                    help="'user' = human turns + assistant tool-call intents only "
                         "(drops assistant prose/thinking) — the cheap arc view for huge sessions")
    a = ap.parse_args()

    def rows_for_scope(limit, all_projects):
        if CODEX_DEFAULT:
            return _codex_scope_rows(a.project, all_projects, limit), None
        return _scope_rows(a.project, all_projects, limit=limit)

    if a.list:
        rows, _ = rows_for_scope(a.limit, a.all_projects)
        if not rows:
            print(f"{PROG}: no sessions found for this scope.", file=sys.stderr)
            sys.exit(1)
        _emit_list(rows, a.json)
        return

    chain, project_dir, codex_path = [], None, None

    if a.session:
        # Own store first, then the other one: a path or id is read in whatever format it is.
        p = Path(a.session)
        if p.suffix == ".jsonl" and p.exists():
            if _is_codex(p):
                codex_path = p
            else:
                chain, project_dir = _find_session(a.session)
        elif CODEX_DEFAULT:
            codex_path = _codex_find(a.session)
            if not codex_path:
                chain, project_dir = _find_session(a.session)
        else:
            chain, project_dir = _find_session(a.session)
            if not chain:
                codex_path = _codex_find(a.session)
        if not chain and not codex_path:
            print(f"{PROG}: no session found for '{a.session}'", file=sys.stderr)
            sys.exit(1)
    else:
        rows, project_dir = rows_for_scope(20, a.all_projects and a.pick)
        if not rows:
            kind = "Codex" if CODEX_DEFAULT else "CC"
            print(f"{PROG}: no {kind} sessions for this cwd; pass a session-id, --project NAME, or --list",
                  file=sys.stderr)
            sys.exit(1)
        if a.pick:
            if not sys.stdin.isatty():
                print(f"{PROG}: --pick needs an interactive terminal. For agents/scripts run "
                      f"`{PROG} --list [--json]` to get ids, then `{PROG} <id>`.", file=sys.stderr)
                sys.exit(2)
            import datetime as _dt
            titles = _ccd_titles()
            for i, (f, m, d) in enumerate(rows, 1):
                age = _dt.datetime.fromtimestamp(m).strftime("%b %d %H:%M")
                if isinstance(d, str):
                    proj, label = d, _codex_titles().get(_codex_id(f)) or _codex_first_request(f)
                else:
                    proj, label = d.name.rsplit("-", 1)[-1], titles.get(Path(f).stem) or _first_user_title(str(f))
                print(f"  [{i:2}] {age}  {proj:<16} {label}", file=sys.stderr)
            try:
                f, _, d = rows[int(input("pick #: ").strip()) - 1]
            except (ValueError, IndexError, EOFError, KeyboardInterrupt):
                print(f"{PROG}: cancelled.", file=sys.stderr)
                sys.exit(1)
        else:
            f, _, d = rows[0]
        if isinstance(d, str):
            codex_path = f
        else:
            sid = _session_id_of(str(f)) or f.stem
            dirs = _dirs_containing_session(sid) or [d]
            chain, project_dir = _chain_for_session(sid, dirs), dirs[0]

    if codex_path:
        chain = [str(codex_path)]
        turns = distill_codex(codex_path, keep_thinking=not a.no_thinking,
                              thinking_chars=a.thinking_chars, level=a.level)
    else:
        # schema-version sanity (warn only — parser is defensive)
        ver = ""
        try:
            ver = json.loads(next(open(chain[0], encoding="utf-8", errors="replace"))).get("version", "")
        except Exception:
            pass
        if ver and not ver.startswith(KNOWN_VERSION_PREFIX):
            print(f"{PROG}: warning — session CC version {ver} outside tested {KNOWN_VERSION_PREFIX}x; "
                  f"schema may have drifted, review output.", file=sys.stderr)
        turns = distill(chain, keep_thinking=not a.no_thinking,
                        thinking_chars=a.thinking_chars, level=a.level)
    if not turns:
        print(f"{PROG}: session had no distillable content.", file=sys.stderr)
        sys.exit(1)

    total = len(turns)
    if a.since or a.until or a.last:
        turns = window(turns, since=a.since, until=a.until, last=a.last)
        if not turns:
            print(f"{PROG}: the requested window contains no turns.", file=sys.stderr)
            sys.exit(1)

    bits = []
    if a.since:  bits.append(f"since {a.since}")
    if a.until:  bits.append(f"until {a.until}")
    if a.last:   bits.append(f"last {a.last} turns")
    if a.level != "full": bits.append("level=user (assistant prose dropped, tool-call intents kept)")
    slice_note = ", ".join(bits) + f" — {len(turns)} of {total} turns" if bits else ""

    meta = (_codex_render_meta(codex_path, len(turns)) if codex_path
            else _cc_render_meta(chain, project_dir, len(turns)))
    text = render(turns, meta,
                  with_header=not (a.no_header or a.raw),
                  with_meta=not a.raw,
                  slice_note=slice_note)

    if _SECRET_RE.search(text):
        print(f"{PROG}: ⚠ possible secret in output (a tool input may contain a key) — review before sharing.",
              file=sys.stderr)

    raw_bytes = sum(os.path.getsize(f) for f in chain if os.path.exists(f))
    out_bytes = len(text.encode("utf-8"))
    ratio = raw_bytes / out_bytes if out_bytes else 0
    print(f"{PROG}: {len(chain)} file(s), {len(turns)} turns  •  "
          f"{raw_bytes//1024} KB → {out_bytes//1024} KB (~{ratio:.1f}× smaller, "
          f"~{_est_tokens(text):,} tokens)", file=sys.stderr)

    if a.out:
        Path(a.out).write_text(text, encoding="utf-8")
        print(f"{PROG}: wrote {a.out}", file=sys.stderr)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
